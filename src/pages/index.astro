---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);
---

<BaseLayout title="帆哥AI研究院">
  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-label">个人主页</p>
      <h1>帆哥Benjamin</h1>
      <p class="tagline">
        <strong>不会写代码的互联网科技人</strong>，在 B2B SaaS 等互联网行业摸爬滚打十几年。
        从产品运营、平台运营、给客户讲价值、做 Demo、再到KA销售和搭渠道体系，现在正在用 AI Agent 把一个个想法变成能用的产品。
      </p>
      <p class="intro">
        见过太多企业数字化转型喊口号落不了地，也见过太多好工具因为"不会用"被束之高阁。
        这里记录我用 AI 构建数字产品、跑自媒体自动化、以及把 AI 工具落地到真实业务场景的实践。
      </p>
      <div class="hero-actions">
        <a class="cta cta-primary" href="/blog">读文章 →</a>
        <a class="cta cta-secondary" href="/about">关于我</a>
      </div>
    </div>
  </section>

  <!-- ── What I write ── -->
  <section class="topics card">
    <h2>我会写什么</h2>
    <div class="topic-grid">
      <div class="topic-item">
        <span class="topic-icon">🤖</span>
        <div>
          <strong>AI 与副业</strong>
          <p>怎么用 AI 杠杆把个人能力放大</p>
        </div>
      </div>
      <div class="topic-item">
        <span class="topic-icon">🔍</span>
        <div>
          <strong>商业化</strong>
          <p>从需求信号反推机会、验证、执行、复盘</p>
        </div>
      </div>
      <div class="topic-item">
        <span class="topic-icon">🛠</span>
        <div>
          <strong>工具与方法</strong>
          <p>我自己在用的系统</p>
        </div>
      </div>
    </div>
    <p class="topic-note">写得慢，但尽量诚实。</p>
  </section>

  <!-- ── Recent posts ── -->
  <section class="recent card">
    <h2>近期文章</h2>
    <ul class="post-list">
      {
        posts.map((post, i) => (
          <li>
            <span class="post-index">{String(i + 1).padStart(2, '0')}</span>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <span class="date"><FormattedDate date={post.data.date} /></span>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/blog">查看全部文章 →</a></p>
  </section>

  <!-- ── CTA bar ── -->
  <section class="bottom-cta">
    <p>如果你也想搭一个类似的站点，可以看看仓库里的 README —— 十分钟就能起来。</p>
    <a href="https://github.com/wangan0214/Fan" target="_blank" rel="noopener">GitHub →</a>
  </section>
</BaseLayout>

<style>
  /* ── Hero — 柔和一体式 ── */
  .hero {
    padding: 0;
    position: relative;
  }
  .hero-inner {
    text-align: center;
    padding: 3.5rem 2.5rem 3rem;
    background: linear-gradient(180deg, rgba(184,74,60,0.03) 0%, transparent 60%);
    border-radius: var(--radius);
    border: 1px solid rgba(0,0,0,0.035);
  }
  .hero-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-light);
    margin: 0 0 1.2rem;
    opacity: 0.7;
  }
  .hero h1 {
    font-family: var(--serif-head);
    font-size: 1.65rem;
    font-weight: 600;
    margin: 0 0 0.6rem;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .tagline {
    font-family: var(--serif-body);
    font-size: var(--fs-body);
    color: var(--text-secondary);
    margin: 0 0 1.2rem;
    line-height: 1.8;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }
  .tagline strong {
    color: var(--text-primary);
    font-weight: 600;
  }
  .intro {
    max-width: 34rem;
    margin: 0 auto 1.8rem;
    color: var(--text-light);
    font-size: var(--fs-sm);
    line-height: 1.8;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  /* Buttons */
  .cta {
    display: inline-block;
    padding: 0.65rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
    transition: all 0.22s ease;
    cursor: pointer;
  }
  .cta-primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 2px 10px rgba(184, 74, 60, 0.3);
  }
  .cta-primary:hover {
    background: var(--accent-dark);
    box-shadow: 0 4px 18px rgba(184, 74, 60, 0.4);
    transform: translateY(-1px);
    color: #fff;
  }
  .cta-secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 1.5px solid var(--rule-dark);
  }
  .cta-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  /* ── Card sections — 统一板式 ── */
  .card {
    background: var(--bg-card);
    border-radius: var(--radius);
    padding: 2.2rem 2.4rem;
    margin-top: 2rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0,0,0,0.04);
  }

  /* ── Topics ── */
  .topics h2 { margin-top: 0; font-size: var(--fs-h2); }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.2rem;
    margin: 1.5rem 0 1rem;
  }
  .topic-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    background: rgba(0,0,0,0.015);
    border-radius: 8px;
    transition: background 0.2s ease;
  }
  .topic-item:hover { background: rgba(0,0,0,0.03); }
  .topic-icon { font-size: 1.5rem; flex-shrink: 0; line-height: 1; }
  .topic-item strong {
    display: block;
    font-family: var(--serif-head);
    font-size: var(--fs-body);
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }
  .topic-item p {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-light);
    line-height: 1.5;
  }
  .topic-note {
    font-style: italic;
    color: var(--text-light);
    font-size: var(--fs-sm);
    margin: 0.5rem 0 0;
  }

  /* ── Recent posts ── */
  .recent h2 { margin-top: 0; font-size: var(--fs-h2); }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0.5rem;
  }
  .post-list li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #f0ebe1;
    transition: background 0.15s ease;
  }
  .post-list li:last-child { border-bottom: none; }
  .post-list li:hover { background: rgba(184, 74, 60, 0.02); margin: 0 -0.5rem; padding-left: 0.5rem; padding-right: 0.5rem; border-radius: 6px; }
  .post-index {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: var(--fs-xs);
    color: var(--text-light);
    opacity: 0.5;
    min-width: 1.5em;
  }
  .post-list a {
    color: var(--text-primary);
    text-decoration: none;
    font-size: var(--fs-body);
    font-weight: 500;
    flex: 1;
    transition: color 0.18s ease;
  }
  .post-list a:hover { color: var(--accent); }
  .date {
    color: var(--text-light);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }
  .more {
    margin: 1rem 0 0;
    text-align: right;
  }
  .more a {
    color: var(--accent);
    font-weight: 500;
    font-size: var(--fs-sm);
  }

  /* ── Bottom CTA ── */
  .bottom-cta {
    text-align: center;
    padding: 2.5rem 1rem;
    margin-top: 2rem;
    color: var(--text-light);
    font-size: var(--fs-sm);
  }
  .bottom-cta p { margin: 0 0 0.8rem; }
  .bottom-cta a {
    display: inline-block;
    color: var(--accent);
    font-weight: 600;
    border-bottom: 1.5px solid var(--accent);
    padding-bottom: 2px;
  }
  .bottom-cta a:hover { color: var(--accent-dark); }

  @media (max-width: 600px) {
    .hero-inner { padding: 2.5rem 1.5rem 2.2rem; }
    .hero h1 { font-size: 1.4rem; }
    .tagline { font-size: var(--fs-sm); line-height: 1.75; }
    .card { padding: 1.5rem 1.3rem; }
    .hero-actions { flex-direction: column; align-items: center; }
    .cta { width: 100%; max-width: 220px; text-align: center; }
    .topic-grid { grid-template-columns: 1fr; }
  }
</style>
