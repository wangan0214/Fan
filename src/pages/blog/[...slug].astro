---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-article">
    <header class="post-header">
      <div class="header-accent"></div>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <FormattedDate date={post.data.date} />
        {post.data.tags.length ? ' · ' + post.data.tags.join(' / ') : ''}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">← 返回文章列表</a>
      <a href="/rss.xml" class="rss-link-footer">订阅 RSS</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-article { max-width: 100%; }

  .post-header {
    text-align: center;
    padding: 0.5rem 0 2.5rem;
    margin-bottom: 1rem;
  }
  .header-accent {
    width: 50px; height: 3px;
    background: linear-gradient(to right, var(--accent), transparent);
    margin: 0 auto 1.5rem; border-radius: 2px;
  }
  .post-header h1 {
    font-size: 2.4rem;
    line-height: 1.2;
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }
  .meta {
    color: var(--text-light);
    font-size: 0.88rem;
    margin: 0;
  }

  .prose {
    background: var(--bg-card);
    border-radius: var(--radius);
    padding: 2rem 2.2rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0,0,0,0.04);
    font-size: 1.02rem;
    line-height: 1.8;
  }
  .prose :global(p) { margin: 1.3em 0; }
  .prose :global(h2) {
    margin-top: 2em;
    font-size: 1.55rem;
    padding-top: 0.8em;
  }
  .prose :global(h3) {
    margin-top: 1.6em;
    font-size: 1.25rem;
  }
  .prose :global(a) { color: var(--accent); }
  .prose :global(a:hover) { color: var(--accent-dark); }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 1.5em 0;
    padding: 0.8em 1.3em;
    background: var(--accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-secondary);
    font-style: italic;
  }
  .prose :global(pre) {
    background: var(--bg-deep);
    color: #d4cfc4;
    padding: 1.2em 1.4em;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 1.5em 0;
  }
  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .prose :global(:not(pre) > code) {
    background: rgba(0,0,0,0.05);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.88em;
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    margin: 1.8em 0;
  }
  .prose :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--rule), transparent);
    margin: 2.5em 0;
  }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.5em; margin: 1.2em 0; }
  .prose :global(li) { margin: 0.45em 0; }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .back-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.18s ease;
  }
  .back-link:hover { color: var(--accent); }
  .rss-link-footer {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    border-bottom: 1.5px solid var(--accent);
    padding-bottom: 2px;
  }

  @media (max-width: 600px) {
    .post-header h1 { font-size: 1.85rem; }
    .prose { padding: 1.4rem 1.2rem; }
    .post-footer { flex-direction: column; gap: 0.8rem; align-items: flex-start; }
  }
</style>
