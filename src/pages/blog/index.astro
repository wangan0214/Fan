---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="文章 | 帆哥" description="帆哥的文章列表">
  <div class="blog-page">
    <header class="page-header">
      <div class="header-accent"></div>
      <h1>全部文章</h1>
      <p class="header-sub">关于 AI、副业与商业化的思考与实践</p>
    </header>

    <div class="post-list">
      {
        posts.map((post, i) => (
          <a href={`/blog/${post.id}/`} class="post-card">
            <span class="post-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="post-info">
              <h3>{post.data.title}</h3>
              <p class="post-desc">{post.data.description}</p>
              <span class="post-meta">
                <FormattedDate date={post.data.date} />
                {post.data.tags.length ? ' · ' + post.data.tags.join(' / ') : ''}
              </span>
            </div>
            <span class="arrow">→</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .blog-page { max-width: 100%; }

  .page-header { text-align: center; padding: 0.5rem 0 2rem; }
  .header-accent {
    width: 50px; height: 3px;
    background: linear-gradient(to right, var(--accent), transparent);
    margin: 0 auto 1.5rem; border-radius: 2px;
  }
  .page-header h1 { margin-bottom: 0.5rem; }
  .header-sub { color: var(--text-light); font-size: 0.95rem; margin: 0; }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .post-card {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.3rem 1.4rem;
    background: var(--bg-card);
    border-radius: var(--radius);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0,0,0,0.04);
    transition: all 0.22s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }

  .post-num {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.78rem;
    color: var(--text-light);
    opacity: 0.45;
    min-width: 1.6em;
    flex-shrink: 0;
  }

  .post-info { flex: 1; min-width: 0; }
  .post-info h3 {
    font-size: 1.08rem;
    margin: 0 0 0.25rem;
    color: var(--text-primary);
    transition: color 0.18s ease;
  }
  .post-card:hover .post-info h3 { color: var(--accent); }
  .post-desc {
    font-size: 0.87rem;
    color: var(--text-light);
    margin: 0;
    line-height: 1.45;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .post-meta {
    font-size: 0.78rem;
    color: var(--text-light);
    opacity: 0.7;
  }

  .arrow {
    font-size: 1.1rem;
    color: var(--text-light);
    flex-shrink: 0;
    transition: all 0.22s ease;
    opacity: 0;
  }
  .post-card:hover .arrow { opacity: 1; color: var(--accent); transform: translateX(3px); }

  @media (max-width: 600px) {
    .post-card { padding: 1rem; gap: 0.8rem; }
    .post-info h3 { font-size: 1rem; }
    .arrow { display: none; }
  }
</style>
