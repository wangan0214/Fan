---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '帆哥的个人主页 · 关于 AI、副业与商业化' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="帆哥" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vollkorn:ital,wght@0,400;0,600;0,700;1,400&family=Gentium+Book+Basic:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-wrapper">
      <!-- 全宽导航条 -->
      <header class="site-header">
        <div class="header-inner">
          <a href="/" class="site-title">帆哥AI研究院</a>
          <nav class="site-nav">
            <a href="/">首页</a>
            <a href="/tutorial">搭建教程</a>
            <a href="/blog">文章</a>
            <a href="/about">关于</a>
            <a href="/rss.xml" class="rss-link">RSS</a>
          </nav>
        </div>
      </header>
      <main class="content-area">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <p>© {new Date().getFullYear()} 帆哥 · 用 AI 构建数字产品</p>
          <p class="footer-sub">由 <a href="https://astro.build">Astro</a> 驱动 · 托管于 <a href="https://pages.cloudflare.com">Cloudflare Pages</a></p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-deep: #1a1814;
    --bg-warm: #f5f0e8;
    --bg-card: #ffffff;
    --text-primary: #1f1d1a;
    --text-secondary: #5c574e;
    --text-light: #8a8479;
    --accent: #b84a3c;
    --accent-dark: #923828;
    --accent-soft: rgba(184, 74, 60, 0.08);
    --rule: #e5dfd3;
    --rule-dark: #d4cdc0;
    /* 内容区宽度：从 720px 加宽到 1080px */
    --max: 1080px;
    --serif-head: 'Vollkorn', Georgia, 'Songti SC', 'Noto Serif SC', serif;
    --serif-body: 'Gentium Book Basic', Georgia, 'Songti SC', 'Noto Serif SC', serif;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.07);
    --radius: 10px;

    /* ── 统一字体层级系统 ── */
    --fs-display: 2.6rem;    /* 首页 hero 大标题 */
    --fs-h1: 2.2rem;         /* 页面主标题 */
    --fs-h2: 1.5rem;         /* 板块标题（统一） */
    --fs-h3: 1.2rem;         /* 三级标题 */
    --fs-body: 1rem;         /* 正文 */
    --fs-lead: 1.08rem;      /* 引导段落 */
    --fs-sm: 0.9rem;         /* 辅助说明 */
    --fs-xs: 0.82rem;        /* 最小文字（footer/RSS等） */
  }

  * { box-sizing: border-box; }
  html { font-size: 17px; }

  body {
    margin: 0;
    background: var(--bg-warm);
    background-image:
      radial-gradient(ellipse at 20% 0%, rgba(184, 74, 60, 0.04) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 100%, rgba(180, 140, 80, 0.05) 0%, transparent 50%);
    background-attachment: fixed;
    color: var(--text-primary);
    font-family: var(--serif-body);
    line-height: 1.78;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ═══════════════ Header — 全宽毛玻璃导航条 ═══════════════ */
  .site-header {
    width: 100%;
    background: rgba(245, 240, 232, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: box-shadow 0.25s ease;
  }
  .site-header.scrolled {
    box-shadow: 0 2px 20px rgba(0,0,0,0.06);
  }
  .header-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.85rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .site-title {
    font-family: var(--serif-head);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }
  .site-nav a {
    padding: 0.45rem 0.9rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
    transition: color 0.2s ease, background 0.2s ease;
    border-radius: 6px;
    letter-spacing: 0.02em;
  }
  .site-nav a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .rss-link {
    opacity: 0.7;
    font-size: var(--fs-xs);
    padding: 0.45rem 0.6rem;
  }

  /* ═══════════════ Main — 加宽内容区 ═══════════════ */
  .content-area {
    max-width: var(--max);
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
    flex: 1;
    width: 100%;
  }

  /* ═══════════════ Footer ═══════════════ */
  footer.site-footer {
    background: var(--bg-deep);
    color: #9a948a;
    font-size: var(--fs-xs);
    margin-top: auto;
  }
  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 2.5rem 2rem;
    text-align: center;
  }
  .footer-inner p { margin: 0.3em 0; }
  .footer-sub { opacity: 0.65; }
  footer.site-footer a { color: #bfb8aa; text-decoration: none; transition: color 0.2s; }
  footer.site-footer a:hover { color: #ddd4c4; }

  /* ═══════════════ Typography — 统一层级 ═══════════════ */
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-dark); }
  h1, h2, h3, h4 {
    font-family: var(--serif-head);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text-primary);
    letter-spacing: -0.015em;
  }
  h1 { font-size: var(--fs-h1); font-weight: 700; }
  h2 { font-size: var(--fs-h2); margin-top: 2.5rem; }
  h3 { font-size: var(--fs-h3); }

  /* ═══════════════ Content card (for post pages) ═══════════════ */
  .prose { max-width: 100%; }
  .prose p { margin: 1.3em 0; }
  .prose ul, .prose ol { padding-left: 1.5em; margin: 1.2em 0; }
  .prose li { margin: 0.4em 0; }
  .prose blockquote {
    border-left: 3px solid var(--accent);
    margin: 1.5em 0;
    padding: 0.8em 1.2em;
    background: var(--accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-secondary);
    font-style: italic;
  }
  .prose code {
    background: rgba(0,0,0,0.05);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.88em;
  }
  .prose pre {
    background: var(--bg-deep);
    color: #d4cfc4;
    padding: 1.2em 1.4em;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 1.5em 0;
  }
  .prose img {
    max-width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    margin: 1.5em 0;
  }
  .prose hr {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--rule), transparent);
    margin: 2.5em 0;
  }

  @media (max-width: 900px) {
    :root { --max: 100%; }
    .header-inner { padding: 0.75rem 1.2rem; }
    .content-area { padding: 2rem 1.2rem 3rem; }
  }
  @media (max-width: 600px) {
    html { font-size: 16px; }
    .header-inner { padding: 0.65rem 1rem; }
    .site-nav a { padding: 0.35rem 0.6rem; font-size: var(--fs-xs); }
    .content-area { padding: 1.5rem 1rem 3rem; }
    h1 { font-size: 1.8rem; }
    h2 { font-size: 1.35rem; }
  }
</style>

<script>
  // 滚动时给 header 加阴影
  const header = document.querySelector('.site-header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 10);
    }, { passive: true });
  }
</script>
